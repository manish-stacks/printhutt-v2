# ──────────────── Backend API ────────────────
# Express backend base URL. Must include /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ──────────────── Edge middleware (Next.js) ────────────────
# Must EXACTLY match TOKEN_SECRET in the backend .env. The backend issues a
# `token` cookie signed with this secret so middleware verifies locally
# without a network hop.
TOKEN_SECRET=replace-with-legacy-secret-same-as-backend

# ──────────────── App ────────────────
NEXT_PUBLIC_APP_NAME=PrintHutt
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────── Razorpay (public key for client-side checkout widget) ────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
