# ──────────────── Server ────────────────
NODE_ENV=development
PORT=4000
APP_NAME=PrintHutt
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ──────────────── Database ────────────────
MONGO_URL=mongodb://localhost:27017/printhutt

# ──────────────── Redis ────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────── JWT ────────────────
ACCESS_TOKEN_SECRET=replace-with-32-byte-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-32-byte-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d
# Legacy single secret — kept for back-compat with frontend Next middleware
TOKEN_SECRET=replace-with-legacy-secret

# ──────────────── Cookies ────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ──────────────── CORS ────────────────
CORS_ORIGIN=http://localhost:3000

# ──────────────── AWS S3 ────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ──────────────── SMTP ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ──────────────── Shiprocket ────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ──────────────── Razorpay ────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ──────────────── PhonePe ────────────────
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox

# ──────────────── Rate limit ────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
